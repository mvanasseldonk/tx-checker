# Required: Ethereum, Base, Arbitrum and Optimism RPC (https://dashboard.alchemy.com).
# Enable these four networks in the Alchemy app.
ALCHEMY_API_KEY=
# Required in production: Solana mainnet RPC (https://dashboard.helius.dev).
# Without it the public endpoint is used, which rate limits quickly.
HELIUS_API_KEY=
# Optional: higher rate limits for euro prices (CoinGecko Demo plan)
COINGECKO_API_KEY=
# Optional: names of contracts beyond the well-known ones
ETHERSCAN_API_KEY=
